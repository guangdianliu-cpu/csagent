# ===== 形态（决定再加载哪份 .env.<形态>）=====
# 产品咨询那台写 product
AGENT_PROFILE=research


# ===== LLM（必填）=====
LLM_API_KEY=
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3/chat/completions
LLM_MODEL=deepseek-v4-flash
LLM_VISION_MODEL=glm-5.3-flash
LLM_JSON_MODE=true
# LLM_TEMPERATURE=0.2


# ===== 服务 =====
APP_HOST=0.0.0.0
#PUBLIC_BASE_URL=https://lab.leadfund.com.cn/csagent
LOG_LEVEL=ERROR
LOG_FORMAT=console

# ===== 企微公共项（机器人 ID/secret 在 .env.<形态>）=====
WECOM_WELCOME=
WECOM_STREAM_INTERVAL_MS=200
WECOM_APPEND_ROUND_ELAPSED=false

# ===== 微信群（发送机 wecom-sender 主动连本服务推 @我、取回复；留空不启用）=====
# >= 32 字符随机串，发送机 config.local.yaml 的 uplink.token 填同一个
# WECHAT_LINK_TOKEN=

# ===== 宿主鉴权（必填）=====
AGENT_SHARED_SECRET=
AGENT_TOKEN_TTL_SECONDS=1800
AGENT_DOWNLOAD_GRANT_TTL_SECONDS=86400
AGENT_AUTH_ENABLED=true
AGENT_AUTH_DEV_LOGIN=false

# ===== 数据管理后台 =====
# python -m csagent.admin.passwd <用户名> 生成
ADMIN_ACCOUNTS=
# 管理令牌专用签名密钥（>= 32 字符）：只放在本服务，**不给宿主**，且不能与 AGENT_SHARED_SECRET 相同。
# 配了 ADMIN_ACCOUNTS 却没配它，管理后台登录返回 503。生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
ADMIN_TOKEN_SECRET=

# ===== 读类工具额外放行的项目路径（默认空，仅调试部署按需打开）=====
# 逗号分隔，如 docs/,configs/；覆盖 configs/base.yaml 的 workspace.read_escape_prefixes
# WORKSPACE_READ_ESCAPE_PREFIXES=
